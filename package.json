{
  "name": "responses-for-copilot",
  "displayName": "Responses for Copilot",
  "description": "Use configurable OpenAI Responses models in Copilot Chat, with a user-supplied GPT 6.1 Sol endpoint profile.",
  "icon": "resources/responses-icon.png",
  "version": "0.1.0",
  "publisher": "responses-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "copilot",
    "github copilot",
    "copilot chat",
    "vision",
    "byok",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat",
    "openai",
    "responses",
    "gpt-6.1-sol"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "responses-copilot",
        "displayName": "Responses for Copilot"
      }
    ],
    "commands": [
      {
        "command": "responses-copilot.setApiKey",
        "title": "%responses-copilot.command.setApiKey%"
      },
      {
        "command": "responses-copilot.clearApiKey",
        "title": "%responses-copilot.command.clearApiKey%"
      },
      {
        "command": "responses-copilot.resetBaseUrl",
        "title": "%responses-copilot.command.resetBaseUrl%"
      },
      {
        "command": "responses-copilot.setVisionModel",
        "title": "%responses-copilot.command.setVisionModel%"
      },
      {
        "command": "responses-copilot.openSettings",
        "title": "%responses-copilot.command.openSettings%"
      },
      {
        "command": "responses-copilot.showLogs",
        "title": "%responses-copilot.command.showLogs%"
      },
      {
        "command": "responses-copilot.openRequestDumpsFolder",
        "title": "%responses-copilot.command.openRequestDumpsFolder%"
      }
    ],
    "walkthroughs": [
      {
        "id": "responsesGettingStarted",
        "title": "%responses-copilot.walkthrough.title%",
        "description": "%responses-copilot.walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%responses-copilot.walkthrough.setApiKey.title%",
            "description": "%responses-copilot.walkthrough.setApiKey.description%",
            "media": {
              "markdown": "resources/walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:responses-copilot.setApiKey"
            ]
          },
          {
            "id": "showModels",
            "title": "%responses-copilot.walkthrough.showModels.title%",
            "description": "%responses-copilot.walkthrough.showModels.description%",
            "media": {
              "markdown": "resources/walkthrough/show-models.md"
            }
          },
          {
            "id": "advancedSettings",
            "title": "%responses-copilot.walkthrough.advancedSettings.title%",
            "description": "%responses-copilot.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "resources/walkthrough/advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%responses-copilot.config.title%",
      "properties": {
        "responses-copilot.baseUrl": {
          "type": "string",
          "default": "https://gd.yundu.lol/v1/responses",
          "markdownDescription": "%responses-copilot.config.baseUrl.description%"
        },
        "responses-copilot.maxTokens": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "%responses-copilot.config.maxTokens.description%"
        },
        "responses-copilot.requestHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%responses-copilot.config.requestHeaders.description%"
        },
        "responses-copilot.experimental.stabilizeToolList": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%responses-copilot.config.experimental.stabilizeToolList.description%",
          "tags": [
            "experimental"
          ]
        },
        "responses-copilot.modelIdOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "%responses-copilot.config.modelIdOverrides.description%"
        },
        "responses-copilot.visionModel": {
          "type": "string",
          "default": "",
          "tags": [
            "advanced"
          ],
          "markdownDescription": "%responses-copilot.config.visionModel.description%"
        },
        "responses-copilot.visionPrompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "Text extraction is mandatory. Visual description required except T2.5. See OUTPUT FORMAT.\n\n---\n\nTASK 1 - TEXT EXTRACTION (always):\n\n1. Transcribe every detectable character verbatim - all text, symbols, and glyphs of any kind, in any location. Never correct, alter, summarize, paraphrase, or truncate the source.\n\n2. Preserve formatting and spatial grouping:\n   - Monospaced → code block (hint if known). Triple backticks in source → 4-backtick fence.\n   - Proportional → plain text, paragraph breaks.\n   - Tabular → Markdown table.\n   - Ambiguous → code block.\n\n3. Annotate spatial position:\n   - Isolated elements: label + colon.\n   - Multi-region: `[Region: name]` headers (avoids T1.4 collision).\n     [Region: name]\n     (content)\n\n4. Uncertainty markers (place at position):\n   [?] = uncertain char.\n   [unclear] = uncertain span.\n   [possible-artifact] = may not be text.\n   [unreadable] = illegible.\n   [truncated] = cut off at edge (place after last readable char).\n   Never guess or fabricate. If source contains a marker literally, backslash-escape it.\n\n5. Low-quality image: place after `--- Extracted Text ---`, before code block or transcription:\n   (Low image quality - confidence reduced.)\n\n6. No text: output \"No text detected.\" No code block, no other text.\n\n---\n\nTASK 2 - VISUAL DESCRIPTION (unless T2.5):\n\n1. Describe all non-text visual content.\n\n2. Text-heavy: describe application, window chrome, UI state, and color coding.\n\n3. Visual-primary: describe concisely but fully. Note color coding. Do not invent.\n\n4. Diagrams: describe structure - what labels represent, how elements connect. Diagram should be understandable from both sections.\n\n5. Omit Visual Context only for tightly cropped text. If any visual element beyond text is visible, include.\n\n---\n\nMULTIPLE IMAGES:\n\n- Label \"Image 1:\", \"Image 2:\", etc. Single image: skip label.\n- Combined summary only if images are related. If unsure, skip.\n\n---\n\nOUTPUT FORMAT:\n\nSingle image:\n--- Extracted Text ---\n[transcription]\n--- Visual Context ---\n[description]\n\nIf Visual Context omitted (T2.5), drop it.\n\nMultiple images (repeat for each):\nImage 1:\n--- Extracted Text ---\n[transcription]\n--- Visual Context ---\n[description]\n\n--- Combined Summary ---\n[summary - if applicable]\n\n---\n\nSPECIAL CASES:\n\n- Handwriting: best-effort; prepend \"(Handwriting - lower confidence.)\".\n- RTL: preserve direction; note in Visual Context.\n- Overlapping layers: extract all; flag [Foreground:] / [Background:].\n- Color: describe scheme in Visual Context only. Never encode in Extracted Text.\n- Image-in-image: treat as flat; note nesting in Visual Context.\n- Long lines: transcribe fully, no wrap; note overflow in Visual Context.\n\n---\n\nESCAPING - if source text contains a line exactly matching any format marker, backslash-escape it:\n\n- \\--- Extracted Text ---\n- \\--- Visual Context ---\n- \\--- Combined Summary ---\n- \\Image N: (standalone line immediately before a `---` marker)\n\nIf source contains any T1.4 marker literally, backslash-escape it.",
          "markdownDescription": "%responses-copilot.config.visionPrompt.description%"
        },
        "responses-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumItemLabels": [
            "%responses-copilot.config.debugMode.minimal.label%",
            "%responses-copilot.config.debugMode.metadata.label%",
            "%responses-copilot.config.debugMode.verbose.label%"
          ],
          "markdownEnumDescriptions": [
            "%responses-copilot.config.debugMode.minimal.description%",
            "%responses-copilot.config.debugMode.metadata.description%",
            "%responses-copilot.config.debugMode.verbose.description%"
          ],
          "markdownDescription": "%responses-copilot.config.debugMode.description%"
        },
        "responses-copilot.promptCacheKey": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "%responses-copilot.config.promptCacheKey.description%"
        },
        "responses-copilot.models": {
          "type": "array",
          "default": [
            {
              "id": "gpt-6.1-sol",
              "name": "GPT 6.1 Sol",
              "family": "gpt",
              "version": "6.1-sol",
              "maxInputTokens": 272000,
              "maxOutputTokens": 64000,
              "contextWindowTokens": 272000,
              "toolCalling": true,
              "imageInput": true,
              "thinking": true,
              "supportedReasoningEfforts": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "defaultReasoningEffort": "high",
              "canDisableReasoning": false
            }
          ],
          "markdownDescription": "%responses-copilot.config.models.description%",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "maxInputTokens",
              "maxOutputTokens"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "maxInputTokens": {
                "type": "integer",
                "minimum": 1
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1
              },
              "contextWindowTokens": {
                "type": "integer",
                "minimum": 1,
                "description": "%responses-copilot.config.models.contextWindowTokens.description%"
              },
              "toolCalling": {
                "type": "boolean",
                "default": false
              },
              "imageInput": {
                "type": "boolean",
                "default": false
              },
              "thinking": {
                "type": "boolean",
                "default": false
              },
              "supportedReasoningEfforts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              },
              "defaultReasoningEffort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "high"
              },
              "canDisableReasoning": {
                "type": "boolean",
                "default": false,
                "description": "%responses-copilot.config.models.canDisableReasoning.description%"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "vscode:prepublish": "bash .github/scripts/prepare-marketplace-readme.sh && npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "lint": "oxlint",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "package": "vsce package --allow-missing-repository --readme-path dist/README.marketplace.md -o dist/",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.2.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
